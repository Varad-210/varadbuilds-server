generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Booking {
  id            String   @id @default(uuid())
  customerName  String
  phoneNumber   String
  email         String?
  businessType  String
  serviceType   String
  preferredDate DateTime
  preferredTime String
  city          String
  message       String?
  status        String   @default("pending")
  source        String   @default("website")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([phoneNumber])
  @@index([preferredDate])
  @@index([status])
}

model Contact {
  id            String   @id @default(uuid())
  name          String
  phoneNumber   String
  email         String?
  businessType  String
  city          String
  message       String?
  status        String   @default("new")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([phoneNumber])
  @@index([status])
}
