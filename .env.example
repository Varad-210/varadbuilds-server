# PostgreSQL connection string
DATABASE_URL=

# Port the Express server listens on
PORT=5000

# Required. Guards the admin-only booking/contact endpoints
# (list, get by id, update status, delete, stats).
# Generate one, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
# Send it as the x-admin-token header. If unset, those routes return 503.
ADMIN_API_TOKEN=

# Optional. Comma-separated exact origins allowed to call this API from a
# browser. When unset the server allows https://varadbuilds.vercel.app plus
# localhost:8080 (and localhost only outside NODE_ENV=production).
# Setting this REPLACES the defaults, so include every origin you need
# (e.g. a Vercel preview or a custom domain) or those pages will be blocked.
ALLOWED_ORIGINS=

# Used by Web3Forms notifications on the frontend
ADMIN_EMAIL=
EMAIL_USER=
EMAIL_PASS=
